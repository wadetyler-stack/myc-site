---
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = 'Common questions' } = Astro.props;
---
<section class="section">
  <div class="wrap faq">
    <div>
      <span class="eyebrow">FAQ</span>
      <h2>{heading}</h2>
    </div>
    <div class="faq__list">
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq { display: grid; gap: 32px; }
  @media (min-width: 900px) { .faq { grid-template-columns: 1fr 2fr; } }
  details { border-bottom: 1px solid var(--grey-200); }
  details:first-child { border-top: 1px solid var(--grey-200); }
  summary { cursor: pointer; list-style: none; padding: 20px 40px 20px 0; position: relative; font: 600 1.2rem/1.3 var(--font-head); letter-spacing: 0.02em; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 6px; top: 14px; font-size: 1.8rem; color: var(--red); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { color: var(--grey-600); padding-right: 40px; }
</style>
