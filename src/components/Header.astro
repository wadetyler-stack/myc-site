---
import LogoBadge from './LogoBadge.astro';
import { biz, mainServices, areas, telHref } from '../lib/data.js';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const serviceLinks = [
  ...mainServices.map((s) => ({ href: s.slug, label: s.name })),
  { href: '/load-bearing-wall-removal/', label: 'Load-Bearing Wall Removal' },
];
const areaLinks = areas.map((a) => ({ href: a.slug, label: a.name }));
---
<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar__inner">
      <span>Etobicoke · West Toronto · Mississauga · Oakville</span>
      <span class="topbar__right">
        <a href={telHref}>{biz.phone.display}</a>
        <span aria-hidden="true">|</span>
        <span>Mon–Fri 8am–5pm</span>
      </span>
    </div>
  </div>
  <div class="wrap nav">
    <a href="/" class="brand" aria-label="Muddy York Contracting home">
      <LogoBadge size={52} label={false} />
      <span class="brand__text"><strong>Muddy York</strong><span>Contracting</span></span>
    </a>

    <button class="nav__toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="nav__menu" aria-label="Primary">
      <ul>
        <li class="has-sub">
          <button class="nav__sub-toggle" aria-expanded="false">Services</button>
          <ul class="sub">
            {serviceLinks.map((l) => <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
          </ul>
        </li>
        <li><a href="/projects/" aria-current={isActive('/projects/') ? 'page' : undefined}>Projects &amp; Map</a></li>
        <li class="has-sub">
          <button class="nav__sub-toggle" aria-expanded="false">Areas</button>
          <ul class="sub">
            {areaLinks.map((l) => <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
          </ul>
        </li>
        <li><a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined}>About</a></li>
        <li class="nav__cta"><a class="btn btn--red" href="/contact/">Free consultation</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 900; background: var(--paper); border-bottom: 1px solid var(--grey-100); }
  .topbar { background: var(--ink); color: var(--grey-200); font-size: 0.85rem; }
  .topbar__inner { display: flex; justify-content: space-between; gap: 16px; padding-block: 7px; }
  .topbar a { color: #fff; text-decoration: none; font-weight: 600; }
  .topbar__right { display: flex; gap: 10px; white-space: nowrap; }
  @media (max-width: 720px) { .topbar__inner > span:first-child { display: none; } .topbar__inner { justify-content: center; } }

  .nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 76px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .brand__text { display: flex; flex-direction: column; font-family: var(--font-head); text-transform: uppercase; line-height: 1; }
  .brand__text strong { font-size: 1.55rem; letter-spacing: 0.02em; }
  .brand__text span { font-size: 0.92rem; letter-spacing: 0.32em; color: var(--grey-600); margin-top: 3px; }

  .nav__menu > ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 4px; }
  .nav__menu a, .nav__sub-toggle {
    display: block;
    padding: 10px 14px;
    font: 600 1.08rem/1 var(--font-head);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav__sub-toggle::after { content: ''; display: inline-block; margin-left: 7px; border: 5px solid transparent; border-top-color: currentColor; transform: translateY(2px); }
  .nav__menu a[aria-current='page'] { color: var(--red); }
  .nav__menu a:hover, .nav__sub-toggle:hover { color: var(--red); }
  .nav__cta a.btn { color: #fff; padding: 12px 18px; margin-left: 8px; }
  .nav__cta a.btn:hover { color: #fff; }

  .has-sub { position: relative; }
  .sub {
    list-style: none;
    margin: 0;
    padding: 8px 0;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 280px;
    background: var(--paper);
    border: 1px solid var(--grey-100);
    border-top: 3px solid var(--red);
    box-shadow: var(--shadow);
    display: none;
  }
  .sub a { font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-weight: 500; font-size: 1rem; padding: 10px 18px; }
  .has-sub:hover .sub, .has-sub:focus-within .sub, .nav__sub-toggle[aria-expanded='true'] + .sub { display: block; }

  .nav__toggle { display: none; width: 48px; height: 48px; background: none; border: 0; cursor: pointer; position: relative; }
  .nav__bars, .nav__bars::before, .nav__bars::after { position: absolute; left: 12px; width: 24px; height: 2.5px; background: var(--ink); content: ''; transition: transform 0.2s; }
  .nav__bars { top: 23px; }
  .nav__bars::before { left: 0; top: -8px; }
  .nav__bars::after { left: 0; top: 8px; }
  .nav__toggle[aria-expanded='true'] .nav__bars { background: transparent; }
  .nav__toggle[aria-expanded='true'] .nav__bars::before { transform: translateY(8px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] .nav__bars::after { transform: translateY(-8px) rotate(-45deg); }

  @media (max-width: 1020px) {
    .nav__toggle { display: block; }
    .nav__menu { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--grey-100); box-shadow: var(--shadow); max-height: calc(100vh - 110px); overflow: auto; }
    .nav__menu.open { display: block; }
    .nav__menu > ul { flex-direction: column; align-items: stretch; padding: 8px var(--gutter) 20px; gap: 0; }
    .nav__menu a, .nav__sub-toggle { padding: 14px 4px; width: 100%; text-align: left; border-bottom: 1px solid var(--grey-100); }
    .sub { position: static; display: none; box-shadow: none; border: 0; padding: 0 0 0 12px; min-width: 0; }
    .has-sub:hover .sub, .has-sub:focus-within .sub { display: none; }
    .nav__sub-toggle[aria-expanded='true'] + .sub { display: block; }
    .nav__cta a.btn { margin: 16px 0 0; width: 100%; }
    .site-header .nav { position: relative; }
  }
  @media (max-width: 400px) { .brand__text strong { font-size: 1.3rem; } }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('open', !open);
  });
  document.querySelectorAll<HTMLButtonElement>('.nav__sub-toggle').forEach((b) =>
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.nav__sub-toggle').forEach((o) => o.setAttribute('aria-expanded', 'false'));
      b.setAttribute('aria-expanded', String(!open));
    }),
  );
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-sub')) document.querySelectorAll('.nav__sub-toggle').forEach((o) => o.setAttribute('aria-expanded', 'false'));
  });
</script>
