---
/** One lightbox per page. Any <a data-lightbox="group"> opens it; arrows move within the group. */
---
<dialog class="lb" aria-label="Photo viewer">
  <button class="lb__btn lb__close" aria-label="Close">×</button>
  <button class="lb__btn lb__prev" aria-label="Previous photo">‹</button>
  <figure class="lb__fig"><img alt="" /><figcaption></figcaption></figure>
  <button class="lb__btn lb__next" aria-label="Next photo">›</button>
</dialog>
<style>
  .lb { border: 0; padding: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; background: rgb(8 8 8 / 0.96); color: #fff; }
  .lb[open] { display: flex; align-items: center; justify-content: center; }
  .lb::backdrop { background: rgb(0 0 0 / 0.8); }
  .lb__fig { margin: 0; max-width: min(1400px, 92vw); display: flex; flex-direction: column; align-items: center; }
  .lb__fig img { max-height: 84vh; width: auto; max-width: 100%; object-fit: contain; }
  .lb__fig figcaption { margin-top: 12px; font-size: 0.95rem; color: var(--grey-200); text-align: center; }
  .lb__btn { position: absolute; background: rgb(255 255 255 / 0.1); color: #fff; border: 0; width: 52px; height: 52px; font-size: 2rem; line-height: 1; cursor: pointer; border-radius: 50%; }
  .lb__btn:hover { background: var(--red); }
  .lb__close { top: 16px; right: 16px; }
  .lb__prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb__next { right: 16px; top: 50%; transform: translateY(-50%); }
</style>
<script>
  import { initLightbox } from '../scripts/lightbox.js';
  initLightbox();
</script>
