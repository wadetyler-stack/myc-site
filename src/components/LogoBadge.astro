---
/**
 * Vector stand-in for the MYC badge (redrawn from the low-res placeholder).
 * Swap for the official SVG when Dylan supplies it: replace this component's
 * markup, or point it at /brand/logo.svg.
 */
interface Props { size?: number; class?: string; label?: boolean }
const { size = 56, class: cls = '', label = true } = Astro.props;
const uid = `b${Math.random().toString(36).slice(2, 8)}`;
const bolts = Array.from({ length: 8 }, (_, i) => {
  const a = (Math.PI / 4) * i + Math.PI / 8;
  return { x: 100 + 67 * Math.cos(a), y: 100 + 67 * Math.sin(a) };
});
---
<svg
  class={`logo-badge ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role={label ? 'img' : undefined}
  aria-label={label ? 'Muddy York Contracting' : undefined}
  aria-hidden={label ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <path id={`${uid}-top`} d="M 16,100 A 84,84 0 0 1 184,100" />
    <path id={`${uid}-bot`} d="M 8,100 A 92,92 0 0 0 192,100" />
    <clipPath id={`${uid}-clip`}><circle cx="100" cy="100" r="57" /></clipPath>
  </defs>
  <circle cx="100" cy="100" r="99" fill="var(--badge-bg, #111)" />
  <g fill="none" stroke="var(--badge-fg, #fff)">
    <circle cx="100" cy="100" r="77" stroke-width="3" />
    <circle cx="100" cy="100" r="57" stroke-width="3" />
    <g clip-path={`url(#${uid}-clip)`} stroke-width="2.5">
      <line x1="30" y1="76" x2="170" y2="76" />
      <line x1="30" y1="124" x2="170" y2="124" />
    </g>
  </g>
  {bolts.map((b) => (
    <g transform={`translate(${b.x.toFixed(2)} ${b.y.toFixed(2)})`} stroke="var(--badge-fg, #fff)" stroke-width="1.6" fill="none">
      <circle r="4.2" />
      <path d="M-2.4 -2.4 L2.4 2.4 M2.4 -2.4 L-2.4 2.4" />
    </g>
  ))}
  <text x="100" y="114" text-anchor="middle" font-family="'Barlow Condensed', 'Arial Narrow', sans-serif" font-weight="700" font-size="44" letter-spacing="2" fill="none" stroke="var(--badge-fg, #fff)" stroke-width="1.8">MYC</text>
  <g font-family="'Barlow Condensed', 'Arial Narrow', sans-serif" font-weight="600" letter-spacing="1.6" fill="var(--badge-fg, #fff)">
    <text font-size="14.5"><textPath href={`#${uid}-top`} startOffset="50%" text-anchor="middle">FROM CONCEPT TO CREATION</textPath></text>
    <text font-size="13"><textPath href={`#${uid}-bot`} startOffset="50%" text-anchor="middle">MUDDY YORK CONTRACTING</textPath></text>
  </g>
</svg>
