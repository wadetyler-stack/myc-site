---
import { site } from '../lib/data.js';
interface Props { dark?: boolean; heading?: string }
const { dark = false, heading = 'How we work' } = Astro.props;
---
<section class:list={['section', dark ? 'section--dark' : 'section--grey']}>
  <div class="wrap">
    <span class="eyebrow">Our process</span>
    <h2>{heading}</h2>
    <ol class="steps">
      {site.process.map((s, i) => (
        <li class="step">
          <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.step}</h3>
          <p>{s.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 2px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .step { background: var(--paper); padding: 28px 26px 22px; border-top: 4px solid var(--ink); }
  .section--dark .step { background: var(--ink-2); border-top-color: var(--red); }
  .step__n { font: 700 2.6rem/1 var(--font-head); color: var(--red); display: block; margin-bottom: 14px; }
  .step h3 { margin-bottom: 8px; }
  .step p { margin: 0; color: var(--grey-600); }
  .section--dark .step p { color: var(--grey-200); }
</style>
