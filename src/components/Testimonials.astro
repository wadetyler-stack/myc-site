---
import { site } from '../lib/data.js';
interface Props { only?: string[]; full?: boolean }
const { only, full = true } = Astro.props;
const list = site.testimonials.filter((t) => t.status.startsWith('confirmed') && (!only || only.includes(t.service)));
---
{list.length > 0 && (
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">In their words</span>
      <h2>What clients say</h2>
      <div class="quotes">
        {list.map((t) => (
          <figure class="quote">
            <blockquote>
              {(full ? t.quote : [t.pull]).map((p) => <p>{p}</p>)}
            </blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.area}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .quotes { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); margin-top: 32px; align-items: start; }
  .quote { margin: 0; padding: 34px 30px 28px; background: var(--grey-50); border-left: 4px solid var(--red); position: relative; }
  .quote::before { content: '“'; position: absolute; top: -6px; right: 20px; font: 700 6rem/1 var(--font-head); color: var(--grey-200); }
  .quote blockquote { margin: 0 0 18px; position: relative; }
  .quote p { margin-bottom: 0.8em; }
  .quote figcaption { display: flex; flex-direction: column; font-size: 0.95rem; }
  .quote figcaption strong { font-family: var(--font-head); font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .quote figcaption span { color: var(--grey-600); }
</style>
